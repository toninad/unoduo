# Supabase project (Settings → API). The service role key stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys, and the webhook endpoint's signing secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL used for Stripe redirect URLs, e.g. https://unoduo.app
SITE_URL=

# Set to "true" to hold new listings for review instead of publishing them at once.
REQUIRE_APPROVAL=false
